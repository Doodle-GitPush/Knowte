<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NCalc.Core" Version="5.12.0" />
    <PackageReference Include="NCalcSync" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <Resource Include="Assets\Fonts\ChivoMono-Regular.ttf" />
    <Resource Include="Assets\Fonts\ChivoMono-Medium.ttf" />
    <Resource Include="Assets\Icons\tray.ico" />
  </ItemGroup>

</Project>
