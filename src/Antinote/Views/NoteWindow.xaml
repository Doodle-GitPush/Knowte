<Window x:Class="Knowte.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Width="300" Height="420" MinWidth="240" MinHeight="300"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Opacity="0">

    <Window.Resources>
        <FontFamily x:Key="JetBrainsMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource JetBrainsMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBarButtonFg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeBarButtonHoverFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" CornerRadius="16"
            Background="{DynamicResource ThemeBg}"
            Margin="12" MouseLeftButtonDown="MainBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#333333" Opacity="0.18"/>
        </Border.Effect>

        <Grid x:Name="MainGrid" MouseMove="MainGrid_MouseMove">
            <avalonedit:TextEditor x:Name="Editor"
                Background="Transparent" BorderThickness="0"
                Padding="20,28,20,52"
                FontFamily="{StaticResource JetBrainsMono}" FontSize="11"
                Foreground="{DynamicResource ThemeFg}" WordWrap="True"
                ShowLineNumbers="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"/>

            <TextBlock x:Name="Placeholder" Text="Start writing..."
                       FontFamily="{StaticResource JetBrainsMono}" FontSize="11"
                       Foreground="{DynamicResource ThemePlaceholder}" Margin="24,28,0,0"
                       VerticalAlignment="Top" IsHitTestVisible="False"/>

            <!-- Word count — always visible, bottom-left -->
            <TextBlock x:Name="WordCount"
                       FontFamily="{StaticResource JetBrainsMono}" FontSize="9"
                       Foreground="{DynamicResource ThemeSubtle}"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="20,0,0,14"
                       IsHitTestVisible="False"/>

            <!-- Date — always visible, bottom-right -->
            <TextBlock x:Name="DateLabel"
                       FontFamily="{StaticResource JetBrainsMono}" FontSize="9"
                       Foreground="{DynamicResource ThemeSubtle}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,20,14"
                       IsHitTestVisible="False"/>

            <!-- Timer label — shows countdown, center-bottom above control bar -->
            <TextBlock x:Name="TimerLabel"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       FontFamily="{StaticResource JetBrainsMono}"
                       FontSize="9" Foreground="{DynamicResource ThemeMuted}"
                       Margin="0,0,0,40"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>

            <!-- Mode indicator — top-right, shows active modes as colored dots -->
            <StackPanel x:Name="ModeIndicator"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,14,0"
                        IsHitTestVisible="False"/>

            <!-- Control bar — hover-activated -->
            <Border x:Name="ControlBar"
                    VerticalAlignment="Bottom"
                    Height="34"
                    Background="{DynamicResource ThemeBg}"
                    CornerRadius="0,0,14,14"
                    Opacity="0"
                    IsHitTestVisible="False"
                    MouseEnter="ControlBar_MouseEnter"
                    MouseLeave="ControlBar_MouseLeave">
                <Border x:Name="ControlBarInnerBorder"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource ThemeControlBorder}"
                        CornerRadius="0,0,14,14">
                    <Grid Margin="12,0">
                        <!-- Left: prev -->
                        <Button x:Name="PrevNoteBtn" Content="&#x2190;"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Style="{StaticResource BarButton}" Click="PrevNoteBtn_Click"/>
                        <!-- Center: note name -->
                        <TextBlock x:Name="NoteNameLabel"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource JetBrainsMono}"
                                   FontSize="9" Foreground="{DynamicResource ThemeMuted}"/>
                        <!-- Right: next, pin, new -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NextNoteBtn" Content="&#x2192;"
                                    Style="{StaticResource BarButton}" Click="NextNoteBtn_Click"/>
                            <Button x:Name="PinBtn" Content="&#x25CB;"
                                    Style="{StaticResource BarButton}" Click="PinBtn_Click"/>
                            <Button x:Name="NewNoteBtn" Content="+"
                                    Style="{StaticResource BarButton}" Click="NewNoteBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
