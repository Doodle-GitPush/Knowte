<Window x:Class="Knowte.Views.HotkeyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="JetBrainsMono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                              Color="#333333" Opacity="0.18"/>
        </Border.Effect>

        <StackPanel Width="260" Margin="24,22,24,20">

            <!-- Title -->
            <TextBlock Text="Change Shortcut"
                       FontFamily="{StaticResource JetBrainsMono}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#333333"/>

            <!-- Current shortcut -->
            <TextBlock x:Name="CurrentLabel"
                       FontFamily="{StaticResource JetBrainsMono}"
                       FontSize="9" Foreground="#AAAAAA"
                       Margin="0,6,0,0"/>

            <!-- Capture box -->
            <Border x:Name="CaptureBox"
                    Margin="0,14,0,0"
                    Height="44"
                    CornerRadius="8"
                    Background="#F8F8F8"
                    BorderThickness="1.5"
                    BorderBrush="#E0E0E0"
                    Focusable="True"
                    KeyDown="CaptureBox_KeyDown"
                    GotFocus="CaptureBox_GotFocus"
                    LostFocus="CaptureBox_LostFocus"
                    MouseLeftButtonDown="CaptureBox_MouseLeftButtonDown">
                <TextBlock x:Name="CaptureLabel"
                           FontFamily="{StaticResource JetBrainsMono}"
                           FontSize="11" Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Click here, then press your shortcut"/>
            </Border>

            <!-- Validation message -->
            <TextBlock x:Name="ValidationLabel"
                       FontFamily="{StaticResource JetBrainsMono}"
                       FontSize="9" Foreground="#EF4444"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="Cancel"
                        FontFamily="{StaticResource JetBrainsMono}"
                        FontSize="10" Foreground="#AAAAAA"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="10,6"
                        Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="SaveBtn" Content="Save"
                        FontFamily="{StaticResource JetBrainsMono}"
                        FontSize="10" Foreground="White"
                        Background="#F97316" BorderThickness="0"
                        Cursor="Hand" Padding="14,6"
                        IsEnabled="False"
                        Click="SaveBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SaveBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#CCCCCC"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsEnabled" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#EA6C0A"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
