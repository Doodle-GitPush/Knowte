<Window x:Class="Antinote.Views.TimerWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Opacity="0">

    <Window.Resources>
        <FontFamily x:Key="ChivoMono">pack://application:,,,/Assets/Fonts/#Chivo Mono</FontFamily>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="14"
            Background="White"
            Margin="6"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="11" ShadowDepth="1.5"
                              Direction="270" Color="#000000" Opacity="0.08"/>
        </Border.Effect>

        <Border CornerRadius="14" BorderBrush="#CCCCCC" BorderThickness="1">
            <Grid>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="17,12">

                    <!-- Alarm clock icon scaled to 17×17 via Viewbox -->
                    <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Line X1="7"  Y1="6.5" X2="4.5" Y2="3.5"
                                  Stroke="#F97316" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="17" Y1="6.5" X2="19.5" Y2="3.5"
                                  Stroke="#F97316" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="2.5" Canvas.Top="4"
                                     Width="19" Height="19"
                                     Stroke="#F97316" StrokeThickness="1.8"
                                     Fill="Transparent"/>
                            <Line X1="12" Y1="13.5" X2="12" Y2="9"
                                  Stroke="#F97316" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="12" Y1="13.5" X2="16" Y2="13.5"
                                  Stroke="#F97316" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="10.8" Canvas.Top="12.3"
                                     Width="2.5" Height="2.5"
                                     Fill="#F97316"/>
                        </Canvas>
                    </Viewbox>

                    <!-- Gap: 20px -->
                    <Border Width="20"/>

                    <!-- Time -->
                    <TextBlock x:Name="TimeLabel"
                               FontFamily="{StaticResource ChivoMono}"
                               FontSize="17"
                               FontWeight="Medium"
                               Foreground="#333333"
                               VerticalAlignment="Center"
                               TextOptions.TextRenderingMode="ClearType"
                               TextOptions.TextFormattingMode="Display"/>
                </StackPanel>

                <!-- Dismiss — fades in on hover -->
                <Button x:Name="CloseBtn"
                        Content="×"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,7,0"
                        FontSize="9"
                        Foreground="#BBBBBB"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Opacity="0"
                        Click="CloseBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="3,0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Border>
</Window>
